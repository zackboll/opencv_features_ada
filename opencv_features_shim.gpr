with "opencv_core.gpr";
with "config/opencv_features_config.gpr";
with "config/opencv_features_install.gpr";

project OpenCV_Features_Shim is
   for Library_Name use "opencv_features_shim";
   for Languages use ("C++");
   for Source_Dirs use ("cpp");
   for Object_Dir use "obj/shim/" & OpenCV_Features_Config.Build_Profile;
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";
   case OpenCV_Features_Install.Shim_Build is
      when "Static_PIC" => for Library_Kind use "static-pic";
      when "Relocatable" => for Library_Kind use "relocatable";
      when "External_Relocatable" =>
         for Externally_Built use "True";
         --  Retain the C++ language and real sources declared above so that
         --  GPRinstall recognizes a library. Only the MSYS2 builder compiles it.
         for Library_Kind use "relocatable";
   end case;
   Common_Cxx_Switches :=
     ("-std=c++17", "-Wall", "-Wextra", "-Wpedantic", "-Werror",
      "-DOPENCV_FEATURES_BUILDING",
      OpenCV_Features_Install.Include_Switch,
      OpenCV_Features_Install.Core_Bridge_Include_Switch);
   package Compiler is
      for Driver ("C++") use OpenCV_Features_Install.Cxx_Driver;
      case OpenCV_Features_Install.Cxx_Toolchain is
         when "GNU" =>
            for Default_Switches ("C++") use Common_Cxx_Switches;
         when "Apple_Clang" =>
            for Default_Switches ("C++") use
              Common_Cxx_Switches & ("-Wno-error=c11-extensions");
            for Leading_Required_Switches ("C++") use
              ("-c", "-x", "c++", "-isysroot", OpenCV_Features_Install.Cxx_Sysroot);
            for Include_Switches ("C++") use ("-I");
            for Dependency_Switches ("C++") use ("-MMD", "-MF", "");
      end case;
   end Compiler;
   case OpenCV_Features_Install.Shim_Build is
      when "Relocatable" =>
         for Library_Options use
           ("-isysroot", OpenCV_Features_Install.Cxx_Sysroot,
            OpenCV_Features_Install.Library_Search_Switch,
            OpenCV_Features_Install.OpenCV_Features_Link_Option,
            OpenCV_Features_Install.OpenCV_Core_Link_Option);
      when others => null;
   end case;
   package Linker is
      case OpenCV_Features_Install.Shim_Build is
         when "Static_PIC" =>
            for Linker_Options use
              (OpenCV_Features_Install.Library_Search_Switch,
               OpenCV_Features_Install.OpenCV_Features_Link_Option,
               OpenCV_Features_Install.OpenCV_Core_Link_Option,
               OpenCV_Features_Install.Cxx_Runtime_Switch);
         when "Relocatable" =>
            for Driver use OpenCV_Features_Install.Cxx_Driver;
         when "External_Relocatable" => null;
      end case;
   end Linker;
   package Install is
      case OpenCV_Features_Install.Shim_Build is
         when "External_Relocatable" =>
            --  Required, not optional or a stale static archive substitute.
            for Required_Artifacts ("lib/opencv_features_shim") use
              ("lib/libopencv_features_shim.dll.a");
         when "Static_PIC" | "Relocatable" => null;
      end case;
   end Install;
end OpenCV_Features_Shim;
