with "opencv_features.gpr";

with "config/opencv_features_examples_config.gpr";

project Opencv_Features_Examples is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("orb_synthetic.adb");
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("Ada") use
        Opencv_Features_Examples_Config.Ada_Compiler_Switches & ("-gnatwa", "-gnatwe", "-Werror");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Opencv_Features_Examples;
